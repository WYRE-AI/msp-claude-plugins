# Mailprotector API Configuration
# Copy this file to .env and fill in your credentials

# API Key (required)
# A per-manager-role bearer token for the Mailprotector API.
# Obtain from the Mailprotector console: click your profile (top right),
# select the role you manage the reseller with, then "View API Key".
MAILPROTECTOR_API_KEY=your-api-key

# Reseller ID (required)
# Your MSP's reseller ID in Mailprotector. Most API keys are scoped to a
# single reseller; this is the ID that scoped tools default to.
MAILPROTECTOR_RESELLER_ID=12345

# Base URL (optional)
# The Mailprotector API host. Only override for testing.
# MAILPROTECTOR_BASE_URL=https://emailservice.io
