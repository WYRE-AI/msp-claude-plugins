{
  "mcpServers": {
    "acronis": {
      "type": "http",
      "url": "https://conduit.wyre.ai/v1/acronis/mcp",
      "headers": {
        "X-Acronis-Base-Url": "${ACRONIS_BASE_URL}",
        "X-Acronis-Client-Id": "${ACRONIS_CLIENT_ID}",
        "X-Acronis-Client-Secret": "${ACRONIS_CLIENT_SECRET}"
      }
    }
  }
}
