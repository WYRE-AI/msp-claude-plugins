# Cisco Meraki MCP Server
# Generate API key at: Meraki Dashboard > Organization > Settings > Dashboard API access
MERAKI_API_KEY=your-api-key
# Optional default organization ID (skip the org-selection step when you only manage one org)
MERAKI_ORG_ID=
# Optional base URL override for regional clouds.
# Default: https://api.meraki.com/api/v1
# China cloud: https://api.meraki.cn/api/v1
MERAKI_BASE_URL=https://api.meraki.com/api/v1
