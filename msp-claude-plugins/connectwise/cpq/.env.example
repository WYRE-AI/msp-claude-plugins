# ConnectWise CPQ (Sell) API credentials — all three are required.
# CPQ 2022.2+ and a user flagged as an API user.

# Tenant access key. Found in the Sell URL while logged in:
#   https://connectwise.quosalsell.com/QuosalWeb/home?accesskey=<this>
CPQ_ACCESS_KEY=your-access-key

# API key pair. Settings > Organization Settings > API Keys.
# The private key is displayed only once, at creation time.
CPQ_PUBLIC_KEY=your-public-key
CPQ_PRIVATE_KEY=your-private-key
