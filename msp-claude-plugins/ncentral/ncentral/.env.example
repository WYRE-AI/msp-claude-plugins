# N-able N-central credentials
#
# NCENTRAL_SERVER_URL: the base URL of YOUR N-central server. There is no shared
# cloud endpoint — every MSP has its own server FQDN, whether on-prem or
# N-able hosted (e.g. https://ncentral.yourcompany.com or https://n01.n-able.com).
NCENTRAL_SERVER_URL=https://ncentral.yourcompany.com

# NCENTRAL_JWT: a User-API Token (JSON Web Token). Generate it in the N-central UI:
#   Administration → User Management → Users → <your API user> → API Access →
#   Generate JSON Web Token
# Notes:
# - The API user must have MFA disabled (N-central requirement for API tokens).
# - The token inherits that user's role and access-group permissions — create a
#   dedicated least-privilege API user rather than reusing an admin account.
# - This is the permanent token; the MCP server exchanges it for short-lived
#   access/refresh tokens automatically.
NCENTRAL_JWT=your-user-api-token-jwt
